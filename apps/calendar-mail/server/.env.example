# Copy to server/.env on the Pi and fill in. Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# Login, option 1 (used on plasbea.ch): Caddy asks for a password, then adds this secret as the
# X-Proxy-Auth header. At least 32 characters. When set, the Cloudflare settings below are not needed.
# PROXY_AUTH_SECRET=
# Mailbox, CalDAV and Claude credentials (see apps/spamfilter/README.md)
# SECRETS_FILE=/home/plastic/ai-mailbox/secrets.env

# Login, option 2: Cloudflare Access.
# From Cloudflare Zero Trust > Settings > Custom Pages (or Team name): <team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# From Zero Trust > Access > Applications > (your app) > Overview > Application Audience (AUD) Tag
CF_ACCESS_AUD=paste-the-aud-tag-here
# Only these emails may use the app (comma-separated)
ALLOWED_EMAILS=you@example.com

# Optional: where to-dos are stored (default: server/data)
# DATA_DIR=/home/pi/calendar-mail-tool/server/data
