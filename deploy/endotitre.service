# systemd *user* unit for the endotitre backend on the Pi (served at www.plasbea.ch/endotitre/).
# Install: cp deploy/endotitre.service ~/.config/systemd/user/ && systemctl --user enable --now endotitre
[Unit]
Description=endotitre backend (www.plasbea.ch/endotitre/)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/plasbeach/apps/endotitre/server
EnvironmentFile=%h/.config/plasbeach/endotitre.env
ExecStart=/usr/bin/node dist/index.js
# Binds to the Docker bridge address, which only exists once Docker is up: keep retrying.
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
