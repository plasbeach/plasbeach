# systemd unit for the app's backend on the Raspberry Pi.
# Install: see docs/DEPLOY.md. Replace "pi" and the paths if your user or checkout differ.
[Unit]
Description=Calendar + Mail web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/calendar-mail-tool/server
EnvironmentFile=/home/pi/calendar-mail-tool/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/pi/calendar-mail-tool/server
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
